# OpsDeck 生产部署配置
# 用法: cp .env.prod.example .env && 填入真实值

# ---- 必填 ----
# 数据库密码
POSTGRES_PASSWORD=change-me-strong-password
# JWT 签名密钥。生成: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
# 站点地址。有域名填域名(自动 HTTPS);纯内网测试填 :80
SITE_ADDRESS=opsdeck.example.com

# ---- 首次启动 ----
# 初始管理员。留空则随机生成并在日志中打印一次。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ---- 可选 ----
POSTGRES_USER=opsdeck
POSTGRES_DB=opsdeck
ACCESS_TOKEN_EXPIRE_MINUTES=720
LOG_LEVEL=INFO

# Dify 接入(也可登录后在界面上登记)
DIFY_BASE_URL=
DIFY_TOOL_TOKEN=

# 更新检测:GitHub API 只读令牌(可选)。不填也能用,但未认证时每小时仅 60 次。
GITHUB_TOKEN=

# 数据保留
METRIC_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=90

# SSH 私钥目录(用于远程操作被管服务器),默认 ~/.ssh
SSH_DIR=~/.ssh
