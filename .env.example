# OpsDeck 环境变量
# 复制为 .env 后使用: cp .env.example .env

# 数据库
DATABASE_URL=postgresql+psycopg://opsdeck:opsdeck@localhost:5432/opsdeck

# 应用
APP_NAME=OpsDeck
DEBUG=false
LOG_LEVEL=INFO

# 认证
# 生产环境必须设置为随机值,否则 JWT 可被伪造。生成方式: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-32-byte-hex-string
# 令牌有效期(分钟),默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 初始管理员。仅在用户表为空时生效。
# 留空则自动生成随机密码并在启动时打印一次。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# CORS 允许的前端来源(逗号分隔)。部署时改成你的真实域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dify 接入(阶段 4 使用)
DIFY_BASE_URL=
DIFY_API_KEY=
